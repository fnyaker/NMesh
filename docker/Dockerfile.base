# NMesh base image — Python + liboqs (post-quantum crypto) compiled from source.
#
# This layer is heavy (it builds the liboqs C library) and changes rarely, so it
# is built and published on its own — only when requirements.txt, its lock,
# scripts/liboqs.lock or this file changes (see
# .github/workflows/base-image.yml). The application image
# (docker/Dockerfile) builds FROM this one, so ordinary NMesh code changes never
# recompile liboqs.
FROM python:3.14-slim

# liboqs is built with CMake's default generator ("Unix Makefiles"), which
# needs `make` — so build-essential (gcc + g++ + make), not a bare gcc, or CMake
# aborts with "CMAKE_MAKE_PROGRAM is not set".
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake build-essential python3-dev git libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# liboqs is built here, from the release scripts/liboqs.lock names and only
# once its source is proven to be that release — never by the wrapper, whose
# fallback clones whatever the tag points at when it finds no library.
ENV OQS_INSTALL_PATH=/opt/liboqs
COPY scripts/liboqs.lock scripts/build_liboqs.sh ./scripts/
RUN bash ./scripts/build_liboqs.sh "$OQS_INSTALL_PATH" "$(nproc)"

# Every package at the version and hash the lock names (`uv pip compile
# --generate-hashes`, from requirements.txt): a release published after the
# lock, or a file that does not hash to it, is refused.
COPY requirements.txt docker/requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock \
    && python -c "import oqs; oqs.KeyEncapsulation('ML-KEM-768'); oqs.Signature('ML-DSA-65')"
